# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
build/
*.egg-info/
*.egg

# Node
node_modules/
npm-debug.log

# Next.js
.next/
out/

# Environment
.env
.env.local
.env.*.local

# Standards PDFs, generated HTML, and vector stores are fetched/generated at
# provisioning time and are never committed (see README "Data licensing").
# Exception: data/<cc>/manifest.json IS committed — it is curated project
# metadata (sources, editions, sha256 pins, licence + redistribution flags).
# Root-anchored: backend/app/data/ is source code and must stay tracked.
/data/*
!/data/*/
/data/*/*
!/data/*/manifest.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*.log.*

# Testing
.pytest_cache/
.coverage
htmlcov/

# Local tooling (never publish)
reasonix.toml
.reasonix/

# Stale dev data
/data/farm_records.db
/data/app.log

# Generated stress test reports
stress_report*.json

# Generated eval artifacts (regenerable: evals/run_all.py)
/evals/data/

# Local HF model cache (workspace-persistent; never commit)
.hf_cache/

# Generated eval output dumps (regenerable — root-level scratch)
/eval_retrieval_minicpm.txt
/replay_results.txt
/urea_test_result.txt
/judge_probe_out.txt
