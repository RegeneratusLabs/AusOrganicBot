# OrgStandardsBot — runtime configuration
# -------------------------------------------
# DEFAULT (this project's intended stack): fully local OpenBMB — no API key.
#   Reader:  MiniCPM5-1B (stock) via Ollama (orgstandardsbot)
#   Embeddings: MiniCPM-Embedding-Light (minicpm)
#
# Other OpenAI-compatible providers are supported for evaluation only:
#   DeepSeek (OpenCode Go):  LLM_BASE_URL=https://opencode.ai/zen/go/v1  LLM_MODEL=deepseek-v4-flash
#   DeepSeek (direct):       LLM_BASE_URL=https://api.deepseek.com/v1    LLM_MODEL=deepseek-chat
#   OpenAI:                  LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
#   Groq:                    LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
#   Ollama (local):          LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen2.5:0.5b
#   LM Studio (local):       LLM_BASE_URL=http://localhost:1234/v1       LLM_MODEL=local-model

# Local OpenBMB default (leave LLM_API_KEY empty for Ollama)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=orgstandardsbot

# Server
PORT=8080

# Thinking mode — "enabled" or "disabled". DeepSeek defaults to enabled.
# Set THINKING_ENABLED=true to see chain-of-thought reasoning in the UI.
THINKING_ENABLED=false

# Whether to send the DeepSeek-specific `thinking` param.
# auto = only DeepSeek/OpenCode (default) | force = always | off = never
THINKING_PARAM=off

# Optional overrides
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=2048
LOG_LEVEL=INFO

# Embeddings — OpenBMB MiniCPM-Embedding-Light is the default for this project
EMBEDDING_FAMILY=minicpm
# EMBEDDING_FAMILY=all-minilm  # sentence-transformers/all-MiniLM-L6-v2, 384-dim (fallback)
# EMBEDDING_MODEL=             # override the model path entirely
# Switching embedding family requires re-running: python scripts/ingest.py --country <cc>

# Multi-country
# DEFAULT_COUNTRY=au           # country used when the client doesn't specify one

# RAG relevance gate (below this score the model is told the match is weak but
# still answers from retrieved context if it covers the question, or declines
# warmly). Default 0.40 — tuned for MiniCPM-Embedding-Light scores.
# RELEVANCE_THRESHOLD=0.40     # per-country overrides live in data/<cc>/manifest.json

# Hybrid retrieval — dense embeddings fused with BM25 lexical search (RRF).
# Lexical search recovers rare exact terms ("urea", "sulphur", clause numbers)
# that a single averaged embedding smooths away. Set to false for dense-only.
# HYBRID_RETRIEVAL=true
# HYBRID_POOL=20                # candidates per signal before fusion (> TOP_K)

# Security / abuse controls (all optional)
# API_TOKEN=                   # if set: requests need `Authorization: Bearer <token>`
# RATE_LIMIT_PER_MINUTE=30     # max LLM queries per IP per minute (0 = unlimited)
# MAX_QUESTION_LENGTH=500
# MAX_TOP_K=10
# MAX_INGREDIENTS=50
